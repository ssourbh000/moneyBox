NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb://localhost:27017/moneybox

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

# Broker API (Zerodha Kite example — replace with your broker)
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:3001/api/broker/zerodha/callback

# Market data provider
MARKET_DATA_PROVIDER=zerodha
